# Production requires a private nonempty password. Never commit your .env file.
APP_AUTH_USER=research
APP_AUTH_PASSWORD=
HOST=127.0.0.1
PORT=3000
PYTHON_WORKERS=2
PYTHON_QUEUE_LIMIT=16
RESEARCH_RETENTION_DAYS=365
# Set only when TLS terminates at your reverse proxy:
# APP_PUBLIC_ORIGIN=https://research.example.com
# Optional server-only provider configuration:
# LLM_API_KEY=
# LLM_MODEL=
# LLM_API_URL=https://api.openai.com/v1/chat/completions
# Behind a reverse proxy/CDN that sets X-Forwarded-For/-Proto/-Host (e.g. Vercel):
# TRUST_PROXY=1
# Keep run history in the browser instead of server SQLite (ephemeral hosts):
# ARTHA_STORAGE_MODE=browser
# Explicitly allow an anonymous read-only demo when no password is set (production):
# APP_PUBLIC_ACCESS=true
