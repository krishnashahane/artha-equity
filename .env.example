# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# HTTP Basic authentication (required when NODE_ENV=production). Use 12+ characters.
APP_AUTH_USER=research
APP_AUTH_PASSWORD=

# Set to true only when served over HTTPS (behind a TLS reverse proxy).
ENABLE_HSTS=false

# Optional: absolute path to a Python 3.10+ interpreter (defaults to .venv, then python3).
# PYTHON_EXECUTABLE=

# Optional tuning
# API_RATE_LIMIT=90
# PYTHON_MAX_CONCURRENCY=4
# PYTHON_TIMEOUT_MS=30000

# Optional server-side language model (OpenAI-compatible chat-completions endpoint, HTTPS only)
LLM_API_KEY=
LLM_MODEL=
LLM_API_URL=https://api.openai.com/v1/chat/completions
