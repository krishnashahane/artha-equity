# Vercel container runtime: Node HTTP server + stdlib-only Python calculation workers.
# Anonymous, read-only demo profile: no server-side history, proxy-aware security.
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN node scripts/build.mjs \
 && python3 -m compileall -q src backend
USER node
ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000 \
    TRUST_PROXY=1 \
    ARTHA_STORAGE_MODE=browser \
    APP_PUBLIC_ACCESS=true \
    PYTHON_EXECUTABLE=/usr/bin/python3 \
    PYTHONDONTWRITEBYTECODE=1
EXPOSE 3000
ENTRYPOINT ["/usr/bin/tini","--"]
CMD ["node","backend/server.mjs"]
